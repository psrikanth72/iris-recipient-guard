<?xml version="1.0" encoding="UTF-8"?>
<!-- IRIS Recipient Guard - add-in only manifest.
     Deploy through Microsoft 365 admin center > Settings > Integrated apps > Upload custom apps. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>21077d8d-1954-416d-afbb-1d966e5a018b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>IRIS KPO</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="IRIS Recipient Guard"/>
  <Description DefaultValue="Checks recipients, client and attachments before an email leaves IRIS, to prevent sending client data to the wrong person."/>
  <IconUrl DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/"/>
  <AppDomains>
    <AppDomain>https://psrikanth72.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- HTML file for web / new Outlook / Mac; plain JS file for classic Outlook on Windows -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="rgGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="rgOpenPane">
                    <Label resid="PaneButtonLabel"/>
                    <Supertip>
                      <Title resid="PaneButtonLabel"/>
                      <Description resid="PaneButtonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onMessageRecipientsChangedHandler"/>
                <!-- Block: if the add-in can't load, the email can't be sent (fail closed). -->
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="Block"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/guard.js"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://psrikanth72.github.io/iris-recipient-guard/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="IRIS Recipient Guard"/>
          <bt:String id="PaneButtonLabel" DefaultValue="Recipient Guard"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="PaneButtonTip" DefaultValue="Show protection status, pick the client company and check this email before sending."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
